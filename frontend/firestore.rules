rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }
    match /calls/{callId} {
      allow read, write: if request.auth != null;
    }
    match /siteVisits/{visitId} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
